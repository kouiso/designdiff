{
  "name": "@figdiff/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "figdiff-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -b --force && node -e \"require('node:fs').chmodSync('dist/index.js', 0o755)\"",
    "pretypecheck": "pnpm --filter @figdiff/credential-store build && pnpm --filter @figdiff/shared build && pnpm --filter @figdiff/mobile-capture build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "dev": "tsc --watch",
    "test": "vitest run && node script/runtime-smoke-selftest.mjs",
    "test:smoke-selftest": "node script/runtime-smoke-selftest.mjs",
    "test:coverage": "vitest run --coverage",
    "prebuild": "pnpm --filter @figdiff/credential-store build"
  },
  "dependencies": {
    "@figdiff/credential-store": "workspace:*",
    "@figdiff/mobile-capture": "workspace:*",
    "@figdiff/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "pixelmatch": "^5.3.0",
    "sharp": "^0.35.3",
    "yaml": "^2.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6"
  },
  "optionalDependencies": {
    "@playwright/test": "^1.60.0"
  }
}
