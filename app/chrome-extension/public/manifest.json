{
  "manifest_version": 3,
  "name": "PixelRay — FigDiff",
  "description": "Compare Figma designs with implementation screenshots. 7-mode pixel-level diff detection for design QA.",
  "version": "0.1.0",
  "permissions": ["activeTab", "storage", "tabs"],
  "host_permissions": ["https://api.figma.com/*", "https://www.figma.com/*"],
  "externally_connectable": {
    "matches": ["https://www.figma.com/*", "https://figma.com/*"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PixelRay"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": ["*.png", "*.svg"],
      "matches": ["<all_urls>"]
    }
  ]
}
