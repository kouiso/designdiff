{
  "name": "@figdiff/chrome-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.background.json && tsc --noEmit -p tsconfig.content.json && tsc --noEmit -p tsconfig.popup.json",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@figdiff/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.40",
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
