{
  "name": "@figdiff/chrome-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.background.json && tsc --noEmit -p tsconfig.content.json && tsc --noEmit -p tsconfig.popup.json",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "test": "vitest run"
  },
  "dependencies": {
    "@figdiff/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.38",
    "esbuild": "^0.27.4",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
