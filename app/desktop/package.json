{
  "name": "@figdiff/desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main/main.js",
  "scripts": {
    "dev": "unset ELECTRON_RUN_AS_NODE && electron-vite dev",
    "dev:debug": "unset ELECTRON_RUN_AS_NODE && electron-vite dev --inspect=5858 --remote-debugging-port=9236",
    "dev:web": "vite --config vite.web.config.ts",
    "verify:native": "bash ./e2e/verify-native-macos.sh",
    "build": "electron-vite build",
    "build:web": "vite build --config vite.web.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "test": "vitest run",
    "preview": "electron-vite preview",
    "pack": "electron-builder"
  },
  "dependencies": {
    "@figdiff/shared": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^25.10.10",
    "lucide-react": "^0.577.0",
    "pixelmatch": "^7.1.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-i18next": "^16.6.6",
    "tailwind-merge": "^2.6.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^3.0.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/pixelmatch": "^5.2.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.4",
    "electron": "^35.7.5",
    "electron-builder": "^26.8.1",
    "electron-vite": "^3.1.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.59.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^6.4.2",
    "vitest": "^3.2.4",
    "vitest-canvas-mock": "^1.1.4"
  }
}
