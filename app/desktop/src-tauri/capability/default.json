{
  "$schema": "https://raw.githubusercontent.com/nickelpack/tauri/dev/crates/tauri-utils/schema.json",
  "identifier": "default",
  "description": "Default capability for FigDiff desktop app",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "store:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://api.figma.com/*"
        },
        {
          "url": "https://*.figma.com/*"
        }
      ]
    }
  ]
}
