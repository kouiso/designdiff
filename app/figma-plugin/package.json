{
  "name": "@figdiff/figma-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.code.json && tsc --noEmit -p tsconfig.ui.json",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "test": "vitest run"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.104.0",
    "esbuild": "^0.27.4",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
