{
  "name": "figdiff",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "lint:eslint": "eslint .",
    "lint:eslint:fix": "eslint --fix .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:rust": "cd app/desktop/src-tauri && cargo test",
    "format": "biome format --write .",
    "check": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.15",
    "@eslint/js": "^9.28.0",
    "eslint": "^9.28.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.33.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=25.6.1"
  },
  "dependencies": {
    "zod": "^4.3.6"
  }
}
