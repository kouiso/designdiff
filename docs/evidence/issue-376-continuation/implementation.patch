+    );
+    expect(evidence).toBeDefined();
+    if (solidCount === 3) expect(evidence?.contentOffset).toBeUndefined();
+    else {
+      expect(evidence?.contentOffset?.dx).toBeCloseTo(2, 0);
+      expect(evidence?.contentOffset?.peak).toBeGreaterThan(0.99);
