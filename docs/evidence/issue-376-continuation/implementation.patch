+    // 淡い10点は両画像とも被覆0.1未満。各3点しかない濃い点は、
+    // 対応を外しても合計6点なので既存の有効8点条件を満たさない。
+    const evidence = classifySameTokenRasterization(
+      fixture(255, 235, 0),
+      fixture(251, 232, 2),
