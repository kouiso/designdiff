{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@figdiff/credential-store": ["./package/credential-store/src/index.ts"],
      "@figdiff/shared": ["./package/shared/src/index.ts"],
      "@/*": ["./app/desktop/src/*"],
      "@figdiff/mobile-capture": ["./package/mobile-capture/src/index.ts"]
    }
  },
  "include": [
    "package/credential-store/src/**/*.ts",
    "package/shared/src/**/*.ts",
    "package/mobile-capture/src/**/*.ts",
    "app/desktop/src/**/*.ts",
    "app/desktop/src/**/*.tsx",
    "app/desktop/electron/**/*.ts",
    "app/mcp-server/src/**/*.ts",
    "app/mcp-server/vitest.setup.ts",
    "app/chrome-extension/src/**/*.ts",
    "app/figma-plugin/src/**/*.ts"
  ],
  "exclude": ["**/dist", "**/node_modules", "app/desktop/src/__mock__/**"]
}
